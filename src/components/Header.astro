---
import { NAV, SITE, CONTACT } from '../site.config';
const pathname = Astro.url.pathname;
---

<header class="site-header" role="banner">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label={`${SITE.name} — home`}>
      <span class="brand__prompt">ahron@darnell</span><span class="brand__sep">:</span><span class="brand__path">~$</span>
    </a>
    <nav class="nav" aria-label="Main navigation">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{ 'nav__link': true, 'is-active': pathname === item.href }}
              >
                <span class="nav__idx" aria-hidden="true">{String(NAV.indexOf(item)).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={CONTACT.linkedin} class="nav__link nav__link--ext" rel="me noopener" target="_blank">
            linkedin ↗
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    height: var(--nav-h);
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text);
    white-space: nowrap;
  }

  .brand__prompt {
    color: var(--green);
  }

  .brand__sep {
    color: var(--text-dim);
  }

  .brand__path {
    color: var(--text-muted);
  }

  .brand:hover {
    text-shadow: 0 0 10px var(--green-glow);
  }

  .nav ul {
    display: flex;
    gap: var(--sp-2);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .nav__link {
    font-size: 0.82rem;
    color: var(--text-muted);
    padding: 0.35rem 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    white-space: nowrap;
  }

  .nav__link:hover {
    color: var(--text);
    border-color: var(--border);
    text-shadow: none;
  }

  .nav__link.is-active {
    color: var(--green-bright);
    border-color: var(--border);
    background: var(--green-glow-soft);
  }

  .nav__idx {
    color: var(--text-dim);
    font-size: 0.7rem;
    margin-right: 0.35rem;
  }

  .nav__link--ext {
    color: var(--green-bright);
  }

  @media (max-width: 640px) {
    .nav__idx {
      display: none;
    }
    .header__inner {
      height: auto;
      padding-top: var(--sp-2);
      padding-bottom: var(--sp-2);
    }
  }
</style>
